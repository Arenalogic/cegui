@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Compute paths relative to package location
set_and_check(CEGUI_INCLUDE_DIR "@PACKAGE_CEGUI_INCLUDE_DIR@")
set_and_check(CEGUI_LIB_DIR "@PACKAGE_CEGUI_LIB_DIR@")
# Runtime DLLs land in bin/ on Windows only; on Unix all libraries live in
# lib/, so the bin dir is optional and must not hard-fail the config.
set(CEGUI_BIN_DIR "@PACKAGE_CEGUI_BIN_DIR@")
if(NOT EXISTS "${CEGUI_BIN_DIR}")
    set(CEGUI_BIN_DIR "")
endif()

# Our library dependencies (contains definitions for IMPORTED targets)
include("${CMAKE_CURRENT_LIST_DIR}/CEGUITargets.cmake")

# The PACKAGE_INIT expansion for this file is generated without the
# check_required_components macro (NO_CHECK_REQUIRED_COMPONENTS_MACRO), so
# guard the call; CEGUI declares no components.
if(COMMAND check_required_components)
    check_required_components(CEGUI)
endif()
